# Normalise line endings so the repo does not churn depending on which tool
# wrote a file. Without this, git reports "LF will be replaced by CRLF" on every
# add and mixed endings accumulate across editors and agents.
* text=auto

*.cs        text diff=csharp
*.xaml      text
*.csproj    text
*.props     text
*.slnx      text
*.md        text
*.ps1       text
*.json      text
*.gitignore text
*.gitattributes text

# Windows-only binaries that must never be line-ending converted.
*.exe   binary
*.dll   binary
*.pdb   binary
*.zip   binary
*.png   binary
*.ico   binary

# Vendored driver sources keep their own line endings; they are C/C++ built by the WDK, not by our
# .NET tooling, and re-normalising them would create noise in every diff against upstream.
driver/**/*.cpp  -text
driver/**/*.h    -text
driver/**/*.inx  -text
driver/**/*.rc   -text
driver/**/*.vcxproj -text
driver/**/*.bat  -text