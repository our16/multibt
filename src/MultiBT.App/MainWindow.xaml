<Window x:Class="MultiBT.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MultiBT.App"
        mc:Ignorable="d"
        Title="MultiBT" Height="640" Width="880"
        MinHeight="480" MinWidth="720">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#666" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="WarningText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#B35A00" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="🔊 MultiBT" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
            <TextBlock Text="{Binding StatusText}" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#444" />
        </StackPanel>

        <!-- Settings warning: corruption or a newer schema is surfaced, never swallowed -->
        <Border Grid.Row="1" Margin="0,10,0,0" Padding="10" CornerRadius="4"
                Background="#FFF4E5" BorderBrush="#E0B070" BorderThickness="1"
                Visibility="{Binding HasSettingsWarning, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding SettingsWarning}" TextWrapping="Wrap" Foreground="#8A4B00" />
        </Border>

        <!--
          Capture-source warning. This is the single most likely reason "other devices make no
          sound": the mirror captures what the SOURCE endpoint is rendering, so a source that is not
          Windows' default output captures silence and every output goes quiet with no error at all.
        -->
        <Border Grid.Row="1" Margin="0,42,0,0" Padding="10" CornerRadius="4"
                Background="#FDECEA" BorderBrush="#D9534F" BorderThickness="1"
                Visibility="{Binding HasCaptureSourceWarning, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding CaptureSourceWarning}" TextWrapping="Wrap" Foreground="#8A1F1A" />
        </Border>

        <!-- Device list -->
        <GroupBox Grid.Row="2" Header="输出设备" Margin="0,12,0,0" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="刷新设备" Padding="10,4" Click="OnRefreshDevices"
                            ToolTip="重新枚举设备，并刷新各设备的 Windows 端点音量" />
                    <Button Content="自动对齐响度" Padding="10,4" Margin="8,0,0,0" Click="OnAutoMatchLevels"
                            ToolTip="按各设备的 Windows 端点音量对齐响度（只衰减，不放大）。音箱灵敏度差异仍需手动微调。" />
                    <TextBlock Text="延迟预设 (ms)：" Margin="18,0,6,0" VerticalAlignment="Center" />
                    <ComboBox x:Name="LatencyPresetBox" Width="90"
                              SelectionChanged="OnLatencyPresetChanged" />
                    <TextBlock Text="同步模式：" Margin="18,0,6,0" VerticalAlignment="Center" />
                    <ComboBox x:Name="SyncModeBox" Width="150"
                              SelectionChanged="OnSyncModeChanged" />
                </StackPanel>

                <ListBox Grid.Row="1" x:Name="DeviceList" BorderThickness="0"
                         ItemsSource="{Binding Devices}"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--
                                  Primary (capture source) marker.
                                  A RadioButton renders as a dot; the request was for explicit TEXT
                                  instead, and text is also unambiguous in a screenshot or over a
                                  remote session. The button doubles as the selector on rows that
                                  are not primary yet.
                                -->
                                <Button Grid.Column="0"
                                        Content="主设备"
                                        Click="OnPrimaryDeviceClick"
                                        ToolTip="设为主设备（捕获源），并同步切换 Windows 默认输出设备"
                                        VerticalAlignment="Center" Margin="0,0,8,0" Padding="8,2"
                                        Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVisibility}}" />

                                <Button Grid.Column="0"
                                        Content="设为主设备"
                                        Click="OnPrimaryDeviceClick"
                                        ToolTip="设为主设备（捕获源），并同步切换 Windows 默认输出设备"
                                        VerticalAlignment="Center" Margin="0,0,8,0" Padding="8,2"
                                        Visibility="{Binding IsNotPrimary, Converter={StaticResource BoolToVisibility}}" />

                                <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                          VerticalAlignment="Center" Margin="0,0,10,0" />

                                <StackPanel Grid.Column="2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding TransportLabel}" Margin="8,0,0,0" Foreground="#777" />
                                        <TextBlock Text="{Binding Status}" Margin="8,0,0,0" Foreground="#0A7" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding LatencySummary}" Style="{StaticResource HintText}" />

                                    <!--
                                      The device's OWN Windows volume, shown and driven directly.
                                      Our slider is not a multiplier on top of it any more: a multiplier
                                      silently capped the achievable loudness (an endpoint at 61 % could
                                      never exceed 61 % no matter where the slider sat), so "100 %" did
                                      not mean anything. It is initialised FROM the device, so it shows
                                      reality.
                                    -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding EndpointVolumeLabel}" Style="{StaticResource HintText}" />
                                        <Button Content="设为100%" Padding="6,1" Margin="8,0,0,0"
                                                FontSize="10" Click="OnMaximizeEndpointVolume"
                                                ToolTip="把该设备的 Windows 音量拉满——设备偏小时的快速做法" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="设备音量" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <Slider Width="130" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1"
                                            Value="{Binding EndpointVolume, Mode=TwoWay}" VerticalAlignment="Center"
                                            IsEnabled="{Binding HasEndpointVolume}"
                                            ToolTip="该设备在 Windows 中的实际输出音量。拖动即时生效（150ms 合并写入）。" />
                                    <TextBlock Text="{Binding EndpointVolumePercent}" Width="42" Margin="6,0,0,0"
                                               VerticalAlignment="Center" TextAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </GroupBox>

        <!-- System latency: the number that decides whether video is watchable -->
        <Border Grid.Row="3" Margin="0,10,0,0" Padding="10" CornerRadius="4"
                Background="#F4F7FB" BorderBrush="#B8C6D8" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="{Binding SystemLatencySummary}" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource HintText}"
                           Text="对齐到最慢的设备会把整个系统的端到端延迟设为该设备的延迟。蓝牙音箱通常在 150–400 ms，因此“全部已同步”与“能看视频”可能互斥——需要看视频时请切到 WiredOnly。" />
            </StackPanel>
        </Border>

        <!-- Diagnostics -->
        <Border Grid.Row="4" Margin="0,8,0,0" Padding="10" CornerRadius="4"
                Background="#F7F7F7" BorderBrush="#DDD" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="诊断（漂移修正 / 缓冲填充 / 饿死计数）" Style="{StaticResource SectionLabel}" />
                <TextBlock Text="{Binding DiagnosticsSummary}" Style="{StaticResource HintText}" />
            </StackPanel>
        </Border>

        <!-- Transport controls -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="▶ 开始同步" Padding="16,6" Click="OnStart" IsEnabled="{Binding IsNotRunning}" />
            <Button Content="■ 停止" Padding="16,6" Margin="8,0,0,0" Click="OnStop" IsEnabled="{Binding IsRunning}" />
            <Button Content="保存设置" Padding="16,6" Margin="8,0,0,0" Click="OnSave" />
            <TextBlock Style="{StaticResource HintText}" Margin="16,0,0,0" VerticalAlignment="Center"
                       Text="音频通路尚未在真机验证 —— 见 docs/SPEC.md §10 与 docs/PITFALLS.md §D。" />
        </StackPanel>
    </Grid>
</Window>
