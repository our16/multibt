<Window x:Class="MultiBT.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MultiBT.App"
        xmlns:loc="clr-namespace:MultiBT.App.Localization"
        mc:Ignorable="d"
        Title="{Binding Source={x:Static loc:Localizer.Instance}, Path=[App.WindowTitle]}"
        Icon="/Assets/multibt.ico"
        Height="680" Width="1220"
        MinHeight="580" MinWidth="1160"
        Background="#F4F5F7"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <!--
      All user-visible text is bound through Localizer rather than written inline, so the language can
      be switched AT RUNTIME. Localizer raises PropertyChanged("Item[]"), which is what tells WPF every
      indexer result is stale; without that the switch would silently do nothing.

      LAYOUT STABILITY is a hard requirement, not a preference. Every region below has a fixed height and
      every text line is single-line with trimming, because content that appears, disappears or grows must
      not move anything else on the page:

        * the notice strip KEEPS its height when there is no notice, so showing one cannot push the
          device list down. This replaced three banners stacked in one grid row at hand-computed offsets
          (0,10 / 0,42 / 0,74), where each appearance shifted everything below it.
        * device rows are a fixed height, so a status that changes from "running" to a long error cannot
          change the row height and scroll the list.
        * value labels and the primary button have fixed widths, so a number going from "8 ms" to
          "1200 ms" cannot push the sliders sideways.
        * diagnostics is collapsed by default, so its variable-length text never participates in layout.
    -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <SolidColorBrush x:Key="Accent" Color="#2563EB" />
        <SolidColorBrush x:Key="TextPrimary" Color="#111827" />
        <SolidColorBrush x:Key="TextMuted" Color="#6B7280" />
        <SolidColorBrush x:Key="CardBorder" Color="#E5E7EB" />
        <SolidColorBrush x:Key="NoticeText2" Color="#8A5A00" />

        <!-- A rounded, flat button. The default WPF chrome is what made the old window look dated. -->
        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="22,7" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          Dropdowns styled to sit beside the buttons: same height, same border colour, same corner radius.
          They were using the platform default chrome, which is what made the toolbar look assembled from
          two different applications.
        -->
        <Style x:Key="FieldCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,0,4,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="7" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter Grid.Column="0" Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />

                                    <!-- typed text support: editable combos are not used here, but the part
                                         must exist or the template is invalid -->
                                    <TextBlock Grid.Column="0" Margin="{TemplateBinding Padding}"
                                               VerticalAlignment="Center" Visibility="Collapsed"
                                               Text="{TemplateBinding Text}" />

                                    <Path Grid.Column="1" Margin="0,0,9,0" VerticalAlignment="Center"
                                          Data="M0,0 L8,0 L4,5 Z" Fill="{StaticResource TextMuted}" />
                                </Grid>
                            </Border>

                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="White" CornerRadius="7" Margin="0,3,0,0"
                                        BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="320">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          Start/stop in one button. Blue while stopped, red while running, so the colour states the
          consequence of pressing it rather than naming a mode.
        -->
        <Style x:Key="StartStopButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderBrush" Value="#2563EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="22,7" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Opacity, not a colour: the button is blue in one state and red in the other,
                                 and a fixed hover colour would repaint the red one blue-grey. -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,12" />
        </Style>

        <!-- A small muted field label. Labels are deliberately terse: the controls are self-evident. -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Right-aligned numerals in a fixed slot, so the widest value cannot push the layout. -->
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- Single-line only. Anything that wraps can change height and move the page. -->
        <Style x:Key="OneLine" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <!--
      Ctrl+Z / Ctrl+Y step through settings snapshots. Ctrl+Shift+Z is bound as well because it is the
      redo shortcut in many editors and users reach for it out of habit.
    -->
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding RedoCommand}" />
    </Window.InputBindings>

    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================ header ============================ -->
        <Grid Grid.Row="0" Height="34">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                       Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[App.Heading]}"
                       FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />

            <!-- Status is single-line and clipped: it changes constantly and must not reflow the header. -->
            <TextBlock Grid.Column="1" Style="{StaticResource OneLine}" Margin="14,0,14,0"
                       Foreground="{StaticResource TextMuted}" FontSize="12"
                       Text="{Binding StatusText}" />

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,6,0"
                           Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[App.Language]}" />
                <ComboBox x:Name="LanguageBox" Width="104" Style="{StaticResource FieldCombo}"
                          SelectionChanged="OnLanguageSelectionChanged" />
            </StackPanel>
        </Grid>

        <!-- ============================ notice ============================ -->
        <!--
          Height is FIXED and the row is ALWAYS present. The border only changes colour, so a notice
          appearing or disappearing cannot move anything: the space is already reserved.
        -->
        <Border Grid.Row="1" Height="30" Margin="0,10,0,0" CornerRadius="7"
                BorderThickness="1" Padding="10,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasNotice}" Value="True">
                            <Setter Property="Background" Value="#FFF8E7" />
                            <Setter Property="BorderBrush" Value="#EFCB84" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--
                  A read-only TextBox rather than a TextBlock: it can be selected, copied with the keyboard and
                  scrolled sideways, which a TextBlock with an ellipsis cannot. Still ONE line in a fixed-height
                  strip, so revealing or clearing a notice still cannot move anything on the page.
                -->
                <TextBox x:Name="NoticeBox" Grid.Column="0" IsReadOnly="True" BorderThickness="0"
                         Background="Transparent" Padding="0" FontSize="12" TextWrapping="NoWrap"
                         Foreground="{StaticResource NoticeText2}"
                         VerticalAlignment="Center" VerticalContentAlignment="Center"
                         Text="{Binding NoticeText, Mode=OneWay}"
                         ToolTip="{Binding NoticeText}" />

                <Button x:Name="CopyNoticeButton" Grid.Column="1" Margin="8,0,0,0" Padding="8,1"
                        Style="{StaticResource BaseButton}" FontSize="11" VerticalAlignment="Center"
                        Click="OnCopyNotice"
                        Content="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Notice.Copy]}"
                        Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>

        <!-- ============================ devices ============================ -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--
                  toolbar: every control is Auto-sized and the ONLY star column is an empty spacer.
                  That is what makes overlap impossible: a fixed-width control in the star column collapsed
                  to zero width when the row ran out of room and was drawn over the button after it.
                -->
                <Grid Grid.Row="0" Height="32" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Margin="0,0,6,0"
                               Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Sink.Label]}" />
                    <ComboBox Grid.Column="1" x:Name="SinkBox" Width="230" VerticalAlignment="Center"
                              Style="{StaticResource FieldCombo}"
                              SelectionChanged="OnCaptureSinkChanged"
                              ToolTip="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Sink.Tip]}" />

                    <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Margin="16,0,6,0"
                               Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Devices.SyncMode]}" />
                    <ComboBox Grid.Column="3" x:Name="SyncModeBox" Width="134" VerticalAlignment="Center"
                              Style="{StaticResource FieldCombo}" SelectionChanged="OnSyncModeChanged" />

                    <Button Grid.Column="5" Style="{StaticResource BaseButton}" Margin="0,0,6,0"
                            Click="OnRefreshDevices"
                            Content="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Devices.Refresh]}"
                            ToolTip="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Devices.Refresh.Tip]}" />
                    <Button Grid.Column="6" Style="{StaticResource BaseButton}" Margin="0,0,6,0"
                            Click="OnGetVirtualCable"
                            Content="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Sink.GetCable]}"
                            ToolTip="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Sink.GetCable.Tip]}" />
                </Grid>

                <ListBox Grid.Row="1" x:Name="DeviceList" BorderThickness="0" Background="Transparent"
                         ItemsSource="{Binding Devices}"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#F7F8FA" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- Fixed height: a status that changes length must not resize the row. -->
                            <Grid Height="58" ToolTip="{Binding LatencySummary}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                          VerticalAlignment="Center" Margin="2,0,12,0" />

                                <!-- name + state; the latency detail lives in the row tooltip -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                   FontSize="13" Foreground="{StaticResource TextPrimary}"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource OneLine}" Margin="8,0,0,0" FontSize="11"
                                                   Foreground="#B45309" Text="{Binding ConnectionHint}"
                                                   Visibility="{Binding HasConnectionHint, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource OneLine}" FontSize="11" Margin="0,1,0,0"
                                               Foreground="{StaticResource TextMuted}" Text="{Binding Status}" />
                                </StackPanel>

                                <!--
                                  Direction: a picker, not three coordinate boxes and not free text. "Where is
                                  this speaker" has eight answers, and every direction is the same distance
                                  away, so one dropdown replaces what used to need a label AND three fields,
                                  in less width and with no way to type a position that makes no sense.
                                -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                            Margin="0,0,18,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,6,0"
                                               Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Spatial.Label]}" />
                                    <ComboBox Width="104" Height="24" FontSize="12"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource FieldCombo}"
                                              SelectedIndex="{Binding SpatialDirectionIndex, Mode=TwoWay}"
                                              ToolTip="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Spatial.Tip]}">
                                        <ComboBoxItem Content="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Spatial.Dir.0]}" />
                                        <ComboBoxItem Content="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Spatial.Dir.1]}" />
                                        <ComboBoxItem Content="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Spatial.Dir.2]}" />
                                        <ComboBoxItem Content="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Spatial.Dir.3]}" />
                                        <ComboBoxItem Content="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Spatial.Dir.4]}" />
                                        <ComboBoxItem Content="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Spatial.Dir.5]}" />
                                        <ComboBoxItem Content="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Spatial.Dir.6]}" />
                                        <ComboBoxItem Content="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Spatial.Dir.7]}" />
                                    </ComboBox>
                                </StackPanel>

                                <!-- delay -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                            Margin="0,0,18,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,6,0"
                                               Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Delay.Label]}" />
                                    <!--
                                      A field rather than a slider: 0-2000 ms with about 5 ms of useful precision, so a
                                      slider's thumb travel is coarser than the step anyone wants and an exact value
                                      cannot be hit. The two buttons cover the common nudge.
                                    -->
                                    <Button Width="26" Height="24" Padding="0" FontSize="14"
                                            Style="{StaticResource BaseButton}" Click="OnDelayDown"
                                            Content="&#x2212;" VerticalAlignment="Center"
                                            ToolTip="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Delay.Down.Tip]}" />
                                    <TextBox Width="58" Height="24" Margin="4,0,4,0" FontSize="12"
                                             VerticalContentAlignment="Center" TextAlignment="Right"
                                             Text="{Binding ManualOffsetMs, Mode=TwoWay, StringFormat={}{0:0}}"
                                             ToolTip="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Delay.Tip]}" />
                                    <Button Width="26" Height="24" Padding="0" FontSize="14"
                                            Style="{StaticResource BaseButton}" Click="OnDelayUp"
                                            Content="+" VerticalAlignment="Center"
                                            ToolTip="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Delay.Up.Tip]}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="4,0,0,0" Text="ms" />
                                </StackPanel>

                                <!-- volume: drives the device's ACTUAL Windows volume, so 100 % means the device's 100 % -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"
                                            Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,6,0"
                                               Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Volume.Label]}" />
                                    <Slider Width="108" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1"
                                            Value="{Binding EndpointVolume, Mode=TwoWay}" VerticalAlignment="Center"
                                            IsEnabled="{Binding HasEndpointVolume}"
                                            ToolTip="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Volume.Tip]}" />
                                    <TextBlock Style="{StaticResource ValueText}" Width="42" Margin="6,0,0,0"
                                               Text="{Binding EndpointVolumePercent}" />
                                </StackPanel>

                                <!-- Fixed width: "主设备" and "设为主设备" must not shift the sliders -->
                                <Button Grid.Column="5" Width="86" VerticalAlignment="Center" Padding="0,4"
                                        Click="OnPrimaryDeviceClick"
                                        ToolTip="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Primary.Tip]}">
                                    <!--
                                      The primary device is stated in GREEN once it is the primary, and only then:
                                      it is the device every other one is aligned against, so "which one is
                                      primary" has to be answerable at a glance rather than by reading the label.
                                      A style trigger beats the template's hover colour, so hover is re-stated
                                      here as a darker green instead of the shared grey.
                                    -->
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource BaseButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                    <Setter Property="Background" Value="#DCFCE7" />
                                                    <Setter Property="BorderBrush" Value="#16A34A" />
                                                    <Setter Property="Foreground" Value="#15803D" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsPrimary}" Value="True" />
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}"
                                                                   Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Background" Value="#BBF7D0" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.Content>
                                        <TextBlock FontSize="11" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text"
                                                            Value="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Primary.Set]}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                            <Setter Property="Text"
                                                                    Value="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Primary.Marker]}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button.Content>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="2" Style="{StaticResource OneLine}" FontSize="11" Margin="2,10,0,0"
                           Foreground="{StaticResource TextMuted}" Text="{Binding SystemLatencySummary}"
                           ToolTip="{Binding Source={x:Static loc:Localizer.Instance}, Path=[SystemLatency.Hint]}" />
            </Grid>
        </Border>

        <!-- ============================ diagnostics ============================ -->
        <!-- Collapsed by default: its text is variable-length and must not affect the layout until asked for. -->
        <Expander Grid.Row="3" Margin="0,10,0,0" Padding="0"
                  Header="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Diagnostics.Group]}"
                  Foreground="{StaticResource TextMuted}" FontSize="12">
            <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                <TextBlock Text="{Binding DiagnosticsSummary}" FontSize="11"
                           Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
            </Border>
        </Expander>

        <!-- ============================ actions ============================ -->
        <Grid Grid.Row="4" Height="40" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" MinWidth="132" Margin="0,0,8,0"
                    Click="OnStartStop"
                    ToolTip="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Transport.NotVerified]}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource StartStopButton}">
                        <Setter Property="Content"
                                Value="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Transport.Start]}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter Property="Content"
                                        Value="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Transport.Stop]}" />
                                <Setter Property="Background" Value="#DC2626" />
                                <Setter Property="BorderBrush" Value="#DC2626" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!--
              Master volume: multiplies every ticked device at once. It is a gain on top of their own
              volumes, so it changes loudness without disturbing the balance between devices, and 100 %
              always means "exactly what each device is set to".
            -->
            <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Margin="0,0,6,0"
                       Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Master.Label]}" />
            <!--
              A momentary push: it returns to the centre when released, because the devices now hold the
              result. It stops moving when any device reaches 0 % or 100 %, which is why its travel is not
              a fixed range.
            -->
            <Slider Grid.Column="3" Width="150" Minimum="-1" Maximum="1" SmallChange="0.01" LargeChange="0.1"
                    Value="{Binding MasterNudge, Mode=TwoWay}" VerticalAlignment="Center"
                    Thumb.DragCompleted="OnMasterNudgeCompleted"
                    ToolTip="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Master.Tip]}" />
            <TextBlock Grid.Column="4" Style="{StaticResource ValueText}" Width="44" Margin="6,0,12,0"
                       Text="{Binding MasterNudgeLabel}" />

            <Button Grid.Column="5" Style="{StaticResource BaseButton}" MinWidth="96"
                    Click="OnSave"
                    Content="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Transport.Save]}" />
        </Grid>
    </Grid>
</Window>
