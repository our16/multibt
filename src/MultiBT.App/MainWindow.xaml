<Window x:Class="MultiBT.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MultiBT.App"
        xmlns:loc="clr-namespace:MultiBT.App.Localization"
        mc:Ignorable="d"
        Title="{Binding Source={x:Static loc:Localizer.Instance}, Path=[App.WindowTitle]}"
        Icon="/Assets/multibt.ico"
        Height="660" Width="920"
        MinHeight="480" MinWidth="760">

    <!--
      All user-visible text is bound through Localizer rather than written inline, so the language can
      be switched AT RUNTIME. Localizer raises PropertyChanged("Item[]"), which is what tells WPF every
      indexer result is stale; without that the switch would silently do nothing.
    -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#666" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="WarningText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#B35A00" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <!--
      Ctrl+Z / Ctrl+Y step through settings snapshots. Ctrl+Shift+Z is bound as well because it is the
      redo shortcut in many editors and users reach for it out of habit.
    -->
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding RedoCommand}" />
    </Window.InputBindings>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[App.Heading]}"
                       FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
            <TextBlock Text="{Binding StatusText}" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#444" />

            <TextBlock Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[App.Language]}"
                       Margin="24,0,6,0" VerticalAlignment="Center" Foreground="#666" />
            <ComboBox x:Name="LanguageBox" Width="120" VerticalAlignment="Center"
                      SelectionChanged="OnLanguageSelectionChanged" />
        </StackPanel>

        <!-- Settings warning: corruption or a newer schema is surfaced, never swallowed -->
        <Border Grid.Row="1" Margin="0,10,0,0" Padding="10" CornerRadius="4"
                Background="#FFF4E5" BorderBrush="#E0B070" BorderThickness="1"
                Visibility="{Binding HasSettingsWarning, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding SettingsWarning}" TextWrapping="Wrap" Foreground="#8A4B00" />
        </Border>

        <!--
          Capture-source warning. This is the single most likely reason "other devices make no
          sound": the mirror captures what the SOURCE endpoint is rendering, so a source that is not
          Windows' default output captures silence and every output goes quiet with no error at all.
        -->
        <Border Grid.Row="1" Margin="0,42,0,0" Padding="10" CornerRadius="4"
                Background="#FDECEA" BorderBrush="#D9534F" BorderThickness="1"
                Visibility="{Binding HasCaptureSourceWarning, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding CaptureSourceWarning}" TextWrapping="Wrap" Foreground="#8A1F1A" />
        </Border>

        <!--
          Virtual-cable guidance. Without a cable the default device always plays natively and therefore
          cannot be delayed or volume-controlled — which reads as "the primary device is out of control"
          rather than as a missing prerequisite.
        -->
        <Border Grid.Row="1" Margin="0,74,0,0" Padding="10" CornerRadius="4"
                Background="#FFF8E1" BorderBrush="#D9B44A" BorderThickness="1"
                Visibility="{Binding HasInputNote, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding InputNote}" TextWrapping="Wrap" Foreground="#5A4A1F" />
        </Border>

        <!-- Device list -->
        <GroupBox Grid.Row="2" Margin="0,12,0,0" Padding="8"
                  Header="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Devices.Group]}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Padding="10,4" Click="OnRefreshDevices"
                            Content="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Devices.Refresh]}"
                            ToolTip="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Devices.Refresh.Tip]}" />
                    <Button Padding="10,4" Margin="8,0,0,0" Click="OnAutoMatchLevels"
                            Content="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Devices.AutoMatch]}"
                            ToolTip="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Devices.AutoMatch.Tip]}" />
                    <TextBlock Margin="18,0,6,0" VerticalAlignment="Center"
                               Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Devices.LatencyPreset]}" />
                    <ComboBox x:Name="LatencyPresetBox" Width="90"
                              SelectionChanged="OnLatencyPresetChanged" />
                    <TextBlock Margin="18,0,6,0" VerticalAlignment="Center"
                               Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Devices.SyncMode]}" />
                    <ComboBox x:Name="SyncModeBox" Width="150"
                              SelectionChanged="OnSyncModeChanged" />
                    <TextBlock Margin="18,0,6,0" VerticalAlignment="Center"
                               Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Sink.Label]}" />
                    <ComboBox x:Name="SinkBox" Width="210" VerticalAlignment="Center"
                              SelectionChanged="OnCaptureSinkChanged"
                              ToolTip="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Sink.Tip]}" />

                    <Button Padding="8,3" Margin="6,0,0,0" Click="OnGetVirtualCable"
                            Content="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Sink.GetCable]}"
                            ToolTip="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Sink.GetCable.Tip]}" />
                </StackPanel>

                <ListBox Grid.Row="1" x:Name="DeviceList" BorderThickness="0"
                         ItemsSource="{Binding Devices}"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--
                                  Primary (capture source) marker, as explicit TEXT rather than a radio dot.
                                  The button doubles as the selector on rows that are not primary yet.
                                -->
                                <Button Grid.Column="0" Click="OnPrimaryDeviceClick"
                                        Content="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Primary.Marker]}"
                                        ToolTip="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Primary.Tip]}"
                                        VerticalAlignment="Center" Margin="0,0,8,0" Padding="8,2"
                                        Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVisibility}}" />

                                <Button Grid.Column="0" Click="OnPrimaryDeviceClick"
                                        Content="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Primary.Set]}"
                                        ToolTip="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Primary.Tip]}"
                                        VerticalAlignment="Center" Margin="0,0,8,0" Padding="8,2"
                                        Visibility="{Binding IsNotPrimary, Converter={StaticResource BoolToVisibility}}" />

                                <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                          VerticalAlignment="Center" Margin="0,0,10,0" />

                                <StackPanel Grid.Column="2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding TransportLabel}" Margin="8,0,0,0" Foreground="#777" />
                                        <TextBlock Text="{Binding Status}" Margin="8,0,0,0" Foreground="#0A7" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding LatencySummary}" Style="{StaticResource HintText}" />
                                    <TextBlock Text="{Binding EndpointVolumeLabel}" Style="{StaticResource HintText}" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Vertical" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="0,0,6,0"
                                               Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Volume.Label]}" />
                                    <!--
                                      Drives the device's ACTUAL Windows volume, and is initialised from it, so
                                      the slider shows reality and 100 % means 100 % of the device.
                                    -->
                                    <Slider Width="130" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1"
                                            Value="{Binding EndpointVolume, Mode=TwoWay}" VerticalAlignment="Center"
                                            IsEnabled="{Binding HasEndpointVolume}"
                                            ToolTip="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Volume.Tip]}" />
                                    <TextBlock Text="{Binding EndpointVolumePercent}" Width="42" Margin="6,0,0,0"
                                               VerticalAlignment="Center" TextAlignment="Right" />
                                    </StackPanel>

                                    <!--
                                      Manual delay. Without this a device that plays early could not be
                                      brought into line at all: compensation is computed from measurements,
                                      and with none taken it is zero for every device, so each one simply
                                      plays at its own natural latency.
                                    -->
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="0,0,6,0"
                                                   Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Delay.Label]}" />
                                        <Slider Width="140" Minimum="0" Maximum="2000" SmallChange="1" LargeChange="50"
                                                Value="{Binding ManualOffsetMs, Mode=TwoWay}" VerticalAlignment="Center"
                                                ToolTip="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Delay.Tip]}" />
                                        <TextBlock Text="{Binding DelayLabel}" Width="52" Margin="6,0,0,0"
                                                   VerticalAlignment="Center" TextAlignment="Right" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </GroupBox>

        <!-- System latency: the number that decides whether video is watchable -->
        <Border Grid.Row="3" Margin="0,10,0,0" Padding="10" CornerRadius="4"
                Background="#F4F7FB" BorderBrush="#B8C6D8" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="{Binding SystemLatencySummary}" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource HintText}"
                           Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[SystemLatency.Hint]}" />
            </StackPanel>
        </Border>

        <!-- Diagnostics -->
        <Border Grid.Row="4" Margin="0,8,0,0" Padding="10" CornerRadius="4"
                Background="#F7F7F7" BorderBrush="#DDD" BorderThickness="1">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionLabel}"
                           Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Diagnostics.Group]}" />
                <TextBlock Text="{Binding DiagnosticsSummary}" Style="{StaticResource HintText}" />
            </StackPanel>
        </Border>

        <!-- Transport controls -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Padding="16,6" Click="OnStart" IsEnabled="{Binding IsNotRunning}"
                    Content="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Transport.Start]}" />
            <Button Padding="16,6" Margin="8,0,0,0" Click="OnStop" IsEnabled="{Binding IsRunning}"
                    Content="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Transport.Stop]}" />
            <Button Padding="16,6" Margin="8,0,0,0" Click="OnSave"
                    Content="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Transport.Save]}" />
            <TextBlock Style="{StaticResource HintText}" Margin="16,0,0,0" VerticalAlignment="Center"
                       Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Transport.NotVerified]}" />
        </StackPanel>
    </Grid>
</Window>
