<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <!-- Same Windows version floor as Core: the Bluetooth connector needs Windows 11 24H2
         semantics and the WinRT projections the floor unlocks. See docs/PITFALLS.md A1. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>MultiBT.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!--
      Version metadata, so the binary AGREES with the git tag rather than reporting the 1.0.0.0 default.
      Without this a released v0.0.1 tag would point at an executable whose properties say 1.0.0.0, and
      "which build is this?" becomes unanswerable from the file itself.
    -->
    <Version>0.1.2</Version>
    <Product>MultiBT</Product>
    <Description>多设备音频同步输出 — 把一份系统声音同时送到多个音箱，并让它们保持同步。</Description>

    <!-- Bakes the icon into the executable (Explorer, taskbar, Alt-Tab). -->
    <ApplicationIcon>Assets\multibt.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <ProjectReference Include="..\MultiBT.Core\MultiBT.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Also embedded as a WPF resource so the TRAY icon can be loaded as a real multi-size .ico rather
      than by extracting one frame out of the executable. That is what lets Windows pick a crisp
      16/20/24 px frame for the notification area at any DPI instead of downscaling a single bitmap.
    -->
    <Resource Include="Assets\multibt.ico" />
  </ItemGroup>

  <!--
    Deliberately NO MVVM toolkit dependency. The view models here are small enough that a
    hand-rolled ObservableObject is less risk than another package version to keep in step.
    Add CommunityToolkit.Mvvm only when the view-model count justifies it.
  -->

</Project>
